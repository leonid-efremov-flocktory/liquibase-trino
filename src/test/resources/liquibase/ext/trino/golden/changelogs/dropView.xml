<?xml version="1.0" encoding="UTF-8"?>
<!--
    Golden case: <dropView> emitting DROP VIEW.

    Run by TrinoGoldenSqlTest, which generates this changelog's SQL with the writer and compares
    it with golden/expected-sql/dropView.sql verbatim, then really applies it, checks the result
    through information_schema, rolls it back, and drops the schema. The case owns its schema, so
    the cases share one stand and can run in any order.
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <property name="catalog.default" value="iceberg_catalog" dbms="trino"/>
    <property name="schema.golden" value="golden_drop_view" dbms="trino"/>

    <changeSet id="create-schema" author="Leonid-Efremov">
        <sql>
            CREATE SCHEMA IF NOT EXISTS ${catalog.default}.${schema.golden};
        </sql>
        <rollback>
            <sql>
                DROP SCHEMA IF EXISTS ${catalog.default}.${schema.golden} CASCADE;
            </sql>
        </rollback>
    </changeSet>

    <changeSet id="create-table" author="Leonid-Efremov">
        <createTable catalogName="${catalog.default}"
                     schemaName="${schema.golden}"
                     tableName="t">
            <column name="id" type="INT"/>
            <column name="txt" type="VARCHAR(64)"/>
        </createTable>
        <rollback>
            <!--
                IF EXISTS: this runs after the dropping changeset has already rolled back, and a
                <dropView> would generate a bare DROP and fail on a view that is no longer there.
            -->
            <sql>
                DROP VIEW IF EXISTS ${catalog.default}.${schema.golden}.v;
            </sql>
        </rollback>
    </changeSet>

    <changeSet id="create-view" author="Leonid-Efremov">
        <!--
            The select is the element's text, not a selectQuery attribute: the dbchangelog XSD
            models createView as simple string content, and an unknown attribute fails the whole
            changelog at parse time rather than being ignored.
        -->
        <createView catalogName="${catalog.default}"
                    schemaName="${schema.golden}"
                    viewName="v">SELECT id, txt FROM ${catalog.default}.${schema.golden}.t</createView>
        <rollback>
            <!--
                IF EXISTS: this runs after the dropping changeset has already rolled back, and a
                <dropView> would generate a bare DROP and fail on a view that is no longer there.
            -->
            <sql>
                DROP VIEW IF EXISTS ${catalog.default}.${schema.golden}.v;
            </sql>
        </rollback>
    </changeSet>

    <changeSet id="drop-view" author="Leonid-Efremov">
        <dropView catalogName="${catalog.default}"
                  schemaName="${schema.golden}"
                  viewName="v"/>
        <rollback/>
    </changeSet>

</databaseChangeLog>
