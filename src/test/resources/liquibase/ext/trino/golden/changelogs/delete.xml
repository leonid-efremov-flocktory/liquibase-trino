<?xml version="1.0" encoding="UTF-8"?>
<!--
    Golden case: <delete> emitting DELETE ... WHERE.

    Run by TrinoGoldenSqlTest, which generates this changelog's SQL with the writer and compares
    it with golden/expected-sql/delete.sql verbatim, then really applies it, checks the result
    through information_schema, rolls it back, and drops the schema. The case owns its schema, so
    the cases share one stand and can run in any order.
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <property name="catalog.default" value="iceberg_catalog" dbms="trino"/>
    <property name="schema.golden" value="golden_delete" dbms="trino"/>

    <changeSet id="create-schema" author="Leonid-Efremov">
        <sql>
            CREATE SCHEMA IF NOT EXISTS ${catalog.default}.${schema.golden};
        </sql>
        <rollback>
            <sql>
                DROP SCHEMA IF EXISTS ${catalog.default}.${schema.golden} CASCADE;
            </sql>
        </rollback>
    </changeSet>

    <changeSet id="create-table" author="Leonid-Efremov">
        <createTable catalogName="${catalog.default}"
                     schemaName="${schema.golden}"
                     tableName="t">
            <column name="id" type="INT"/>
            <column name="txt" type="VARCHAR(64)"/>
        </createTable>
        <rollback>
            <sql>
                DROP TABLE IF EXISTS ${catalog.default}.${schema.golden}.t;
            </sql>
        </rollback>
    </changeSet>

    <changeSet id="seed-rows" author="Leonid-Efremov">
        <insert catalogName="${catalog.default}"
                schemaName="${schema.golden}"
                tableName="t">
            <column name="id" valueNumeric="1"/>
            <column name="txt" value="остаётся"/>
        </insert>
        <insert catalogName="${catalog.default}"
                schemaName="${schema.golden}"
                tableName="t">
            <column name="id" valueNumeric="2"/>
            <column name="txt" value="удаляется"/>
        </insert>
        <rollback>
            <delete catalogName="${catalog.default}"
                    schemaName="${schema.golden}"
                    tableName="t">
                <where>id IN (1, 2)</where>
            </delete>
        </rollback>
    </changeSet>

    <changeSet id="delete-row" author="Leonid-Efremov">
        <delete catalogName="${catalog.default}"
                schemaName="${schema.golden}"
                tableName="t">
            <where>id = 2</where>
        </delete>
        <rollback>
            <insert catalogName="${catalog.default}"
                    schemaName="${schema.golden}"
                    tableName="t">
                <column name="id" valueNumeric="2"/>
                <column name="txt" value="удаляется"/>
            </insert>
        </rollback>
    </changeSet>

</databaseChangeLog>
