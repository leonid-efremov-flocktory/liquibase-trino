<?xml version="1.0" encoding="UTF-8"?>
<!--
    Golden case: <renameTable> emitting ALTER TABLE ... RENAME TO.

    Run by TrinoGoldenSqlTest, which generates this changelog's SQL with the writer and compares
    it with golden/expected-sql/renameTable.sql verbatim, then really applies it, checks the result
    through information_schema, rolls it back, and drops the schema. The case owns its schema, so
    the cases share one stand and can run in any order.
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <property name="catalog.default" value="iceberg_catalog" dbms="trino"/>
    <property name="schema.golden" value="golden_rename_table" dbms="trino"/>

    <changeSet id="create-schema" author="Leonid-Efremov">
        <sql>
            CREATE SCHEMA IF NOT EXISTS ${catalog.default}.${schema.golden};
        </sql>
        <rollback>
            <sql>
                DROP SCHEMA IF EXISTS ${catalog.default}.${schema.golden} CASCADE;
            </sql>
        </rollback>
    </changeSet>

    <changeSet id="create-table" author="Leonid-Efremov">
        <createTable catalogName="${catalog.default}"
                     schemaName="${schema.golden}"
                     tableName="t_before">
            <column name="id" type="INT"/>
        </createTable>
        <rollback>
            <!--
                t_before, not t_after: by the time this runs the rename has already been rolled
                back, so the table is back under its original name.
            -->
            <sql>
                DROP TABLE IF EXISTS ${catalog.default}.${schema.golden}.t_before;
            </sql>
        </rollback>
    </changeSet>

    <changeSet id="rename-table" author="Leonid-Efremov">
        <renameTable catalogName="${catalog.default}"
                     schemaName="${schema.golden}"
                     oldTableName="t_before"
                     newTableName="t_after"/>
        <rollback>
            <renameTable catalogName="${catalog.default}"
                         schemaName="${schema.golden}"
                         oldTableName="t_after"
                         newTableName="t_before"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
