<?xml version="1.0" encoding="UTF-8"?>
<!--
    Golden case: A partitioned Iceberg table, the reason verbatim DDL exists.

    Run by TrinoGoldenSqlTest, which generates this changelog's SQL with the writer and compares
    it with golden/expected-sql/partitionedTable.sql verbatim, then really applies it, checks the result
    through information_schema, rolls it back, and drops the schema. The case owns its schema, so
    the cases share one stand and can run in any order.
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <property name="catalog.default" value="iceberg_catalog" dbms="trino"/>
    <property name="schema.golden" value="golden_partitioned" dbms="trino"/>

    <changeSet id="create-schema" author="Leonid-Efremov">
        <sql>
            CREATE SCHEMA IF NOT EXISTS ${catalog.default}.${schema.golden};
        </sql>
        <rollback>
            <sql>
                DROP SCHEMA IF EXISTS ${catalog.default}.${schema.golden} CASCADE;
            </sql>
        </rollback>
    </changeSet>

    <changeSet id="partitioned-table" author="Leonid-Efremov">
        <!--
            Raw SQL rather than <createTable>: Liquibase has no change type for a WITH clause, so
            partitioning can only be carried if the DDL travels whole. This is the case the
            extension exists for.
        -->
        <sql splitStatements="false">
            CREATE TABLE ${catalog.default}.${schema.golden}.t (
                id INT,
                ts TIMESTAMP(6)
            )
            WITH (
                format = 'PARQUET',
                partitioning = ARRAY['day(ts)']
            )
        </sql>
        <rollback>
            <sql>
                DROP TABLE ${catalog.default}.${schema.golden}.t;
            </sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
