<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="1" author="Leonid-Efremov">
        <createTable catalogName="iceberg_catalog"
                     schemaName="trino_harness"
                     tableName="create_view">
            <column name="id" type="INT"/>
            <column name="txt" type="VARCHAR(64)"/>
        </createTable>
        <rollback>
            <dropTable catalogName="iceberg_catalog"
                       schemaName="trino_harness"
                       tableName="create_view"/>
        </rollback>
    </changeSet>

    <changeSet id="2" author="Leonid-Efremov">
        <createView catalogName="iceberg_catalog"
                    schemaName="trino_harness"
                    viewName="create_view_v">SELECT id, txt FROM iceberg_catalog.trino_harness.create_view</createView>
        <rollback>
            <dropView catalogName="iceberg_catalog"
                      schemaName="trino_harness"
                      viewName="create_view_v"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
