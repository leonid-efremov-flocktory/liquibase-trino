<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <!-- The one case that owns a schema: <sql> issuing CREATE SCHEMA. -->
    <changeSet id="1" author="Leonid-Efremov">
        <sql>
            CREATE SCHEMA IF NOT EXISTS iceberg_catalog.trino_harness_schema;
        </sql>
        <rollback>
            <sql>
                DROP SCHEMA IF EXISTS iceberg_catalog.trino_harness_schema CASCADE;
            </sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
